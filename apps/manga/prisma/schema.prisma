// Schéma Prisma de l'app Manga.
// Une base dédiée (`manga`) dans le projet Neon — voir README.

generator client {
  provider = "prisma-client-js"
  // Sortie dédiée : en monorepo, le client par défaut (node_modules/.prisma)
  // est hoisté à la racine et les 3 apps s'écraseraient mutuellement.
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Manga suivi dans la collection personnelle
model Manga {
  id             Int      @id @default(autoincrement())
  malId          Int      /// Identifiant MyAnimeList
  title          String
  titleJapanese  String?
  coverImage     String?  /// URL image couverture
  author         String?
  volumes        Int?     /// Nb volumes total (null si en cours)
  chapters       Int?     /// Nb chapitres total
  synopsis       String?
  genres         String?  /// Genres séparés par virgule
  demographic    String?  /// Démographie : "Shounen", "Seinen", "Shoujo", "Josei"
  score          Float?   /// Score MAL
  status         String?  /// "Publishing", "Finished", etc.
  ownedVolumesMap String  @default("[]") /// JSON array des numéros de volumes possédés, ex: "[1,2,3,5]"
  notes          String?  /// Notes perso
  userId         String?  /// Propriétaire (compte ou invité, base auth). Rendu obligatoire après rattachement des données existantes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([malId, userId])
  @@index([userId])
}
