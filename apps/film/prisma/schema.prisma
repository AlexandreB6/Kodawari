// Schéma Prisma de l'app Cinéma.
// Une base dédiée (`cinema`) dans le projet Neon — voir README.

generator client {
  provider = "prisma-client-js"
  // Sortie dédiée : en monorepo, le client par défaut (node_modules/.prisma)
  // est hoisté à la racine et les 3 apps s'écraseraient mutuellement.
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Film suivi dans la collection personnelle
model Movie {
  id               Int       @id @default(autoincrement())
  tmdbId           Int?      /// Identifiant TMDB pour enrichir les métadonnées
  title            String
  posterPath       String?
  overview         String?
  director         String?
  releaseYear      Int?
  watchedAt        DateTime? /// Date à laquelle le film a été vu (optionnelle)
  watchedPrecision String    @default("day") /// Précision de la date : "day" ou "year"
  rating           Float?    /// Note personnelle (0.5–5, par pas de 0.5)
  owned            Boolean   @default(false) /// Possède un exemplaire physique
  ownedFormat      String?   /// Format possédé (DVD, Blu-ray, etc.)
  demoSessionId    String?   /// Sandbox démo : NULL = seed partagé / prod privée
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tmdbId, demoSessionId])
  @@index([demoSessionId])
}
