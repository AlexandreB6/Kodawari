# TMDB — métadonnées des films
TMDB_API_KEY=

# Prisma / Postgres (Neon)
# Base dédiée à cette app — une base par app dans le même projet Neon.
DATABASE_URL=postgres://...
# Connexion non poolée : requise par `prisma migrate` (le pooler Neon fait
# expirer l'advisory lock de migration).
DIRECT_URL=postgres://...

# Comptes (Better Auth) — base `auth` partagée par les 3 apps.
AUTH_DATABASE_URL=postgres://...
AUTH_DIRECT_URL=postgres://...
# Secret de signature des sessions, identique sur les 3 apps
# (node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
BETTER_AUTH_SECRET=
# URL publique de cette app (callbacks OAuth, redirections).
BETTER_AUTH_URL=http://localhost:3000
# Domaine perso uniquement : partage la session entre sous-domaines
# (ex. .kodawari.fr). Laisser vide sur *.vercel.app : une connexion par app.
AUTH_COOKIE_DOMAIN=
# Optionnel : bouton « Continuer avec Google » si les deux sont définis.
# Callback à déclarer chez Google : <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret partagé de la route /api/cron/cleanup-guests (purge des invités).
# Vercel Cron l'injecte en `Authorization: Bearer ${CRON_SECRET}` dès qu'il est
# défini dans les variables d'environnement du projet.
CRON_SECRET=

# URLs des 3 apps pour le sélecteur du header. En prod, valeurs par défaut
# (kodawari-*.vercel.app) si absentes.
NEXT_PUBLIC_APP_URL_FILM=http://localhost:3000
NEXT_PUBLIC_APP_URL_MANGA=http://localhost:3001
NEXT_PUBLIC_APP_URL_PAINT=http://localhost:3002
