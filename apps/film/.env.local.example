# TMDB — métadonnées des films
TMDB_API_KEY=

# Prisma / Postgres (Neon)
# Base dédiée à cette app — une base par app dans le même projet Neon.
DATABASE_URL=postgres://...
# Connexion non poolée : requise par `prisma migrate` (le pooler Neon fait
# expirer l'advisory lock de migration).
DIRECT_URL=postgres://...

# Mode démo — "true" sur le déploiement portfolio public.
# Active le cookie de sandbox (proxy), le filtrage des routes API et le bandeau.
# Laisser vide / "false" pour l'usage personnel privé.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Secret partagé de la route /api/cron/cleanup-demo.
# Vercel Cron l'injecte en `Authorization: Bearer ${CRON_SECRET}` dès qu'il est
# défini dans les variables d'environnement du projet.
CRON_SECRET=

# Write-gate owner (mode privé uniquement).
# Quand il est défini, les routes API mutantes exigent un cookie `owner_session`
# obtenu en se connectant sur /login. Les lectures restent publiques. Ignoré en
# mode démo et quand la variable est absente (dev local). Changer la valeur
# invalide toutes les sessions existantes (le cookie stocke son sha256).
OWNER_PASSWORD=
